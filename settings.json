  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "terminal-notifier -title 'Claude Code' -message 'Input required' -sender com.anthropic.claudefordesktop -sound default"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "PATH=\"$HOME/.local/node/bin:$PATH\" npx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "permissions-setup@mrlee-plugins": true,
    "productivity@code-factory": true
  },
  "extraKnownMarketplaces": {
    "mrlee-plugins": {
      "source": {
        "source": "github",
        "repo": "DataDog/mrlee-plugins"
      }
    },
    "datadog-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "DataDog/claude-marketplace"
      }
    },
    "code-factory": {
      "source": {
        "source": "github",
        "repo": "rtfpessoa/code-factory"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "autoUpdatesChannel": "stable",
  "autoMemoryEnabled": true,
  "autoDreamEnabled": true,
  "defaultMode": "plan"
}
