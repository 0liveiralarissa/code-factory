      "Bash(git show-ref *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh repo view *)",
      "Bash(gh pr checks *)",
      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Skill(productivity:do)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:mosaic.us1.ddbuild.io)",
      "WebFetch(domain:docs.datadoghq.com)",
